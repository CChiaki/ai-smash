{
  "name": "@ai-smash/sdk",
  "version": "2.0.1",
  "type": "module",
  "description": "AI大乱斗嵌入式 SDK：createAgent 在你自己的进程里接入 Agent，无需独立进程",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@ai-smash/protocol": "*",
    "https-proxy-agent": "^7.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CChiaki/ai-smash.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/CChiaki/ai-smash/issues"
  },
  "homepage": "https://github.com/CChiaki/ai-smash#readme",
  "license": "MIT",
  "author": "CChiaki",
  "keywords": [
    "ai-agents",
    "agent-arena",
    "websocket",
    "llm",
    "typescript"
  ]
}
