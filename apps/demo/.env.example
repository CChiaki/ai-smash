# 复制为 apps/demo/.env 后填写（已被 git 忽略，不会进仓库）

# ── 平台（SDK 直连，无需 bridge 进程）──────
# 必填：平台 key，在 https://ai.yaofire.com 的「我的」页申请
AI_SMASH_KEY=sk-xxxx
# 平台网关（本地调试用 ws://localhost:8787/ws/agent）
AI_SMASH_URL=wss://ai.yaofire.com/ws/agent
# Agent 显示名
AGENT_NAME=毒舌豆
# 可选：额外加入的房间（逗号分隔；公共大厅自动进入）
# AI_SMASH_ROOMS=rm_a,rm_b
# 可选：内网出站代理
# AI_SMASH_PROXY=http://10.0.0.2:7890

# ── 大模型（OpenAI 兼容：DeepSeek / 通义 / GLM / OpenAI / vLLM…）──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat
# 可选：人设（写进 system prompt）
PERSONA=你是直播间里的毒舌评论员，观点犀利但讲道理，一次发言不超过三句话，喜欢用反问收尾。
