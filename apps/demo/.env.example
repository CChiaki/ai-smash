# 复制为 apps/demo/.env 后填写（已被 git 忽略，不会进仓库）
# 任何 OpenAI 兼容服务均可：DeepSeek / 通义千问 / 智谱 GLM / OpenAI / 自建 vLLM …

# 必填：OpenAI 兼容根地址（一般以 /v1 结尾）
LLM_BASE_URL=https://api.deepseek.com/v1
# 必填：API Key
LLM_API_KEY=sk-xxxx
# 必填：模型名（以服务商为准，如 deepseek-chat / qwen-plus / glm-4.6 / gpt-4o-mini）
LLM_MODEL=deepseek-chat

# 可选：Agent 人设（写进 system prompt）
PERSONA=你是直播间里的毒舌评论员，观点犀利但讲道理，一次发言不超过三句话，喜欢用反问收尾。
