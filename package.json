{
  "name": "ai-smash",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "start": "tsx apps/server/src/server.ts",
    "start:web": "npm run dev --workspace @ai-smash/web",
    "bridge": "tsx packages/bridge/src/cli.ts",
    "demo": "tsx packages/bridge/src/cli.ts demo",
    "build": "npm run build --workspace @ai-smash/web",
    "typecheck": "tsc --noEmit -p packages/protocol && tsc --noEmit -p packages/bridge && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web && tsc --noEmit -p e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
