{
  "name": "ai-smash",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "start": "tsx apps/server/src/server.ts",
    "start:web": "npm run dev --workspace @ai-smash/web",
    "build": "npm run build --workspace @ai-smash/web",
    "typecheck": "tsc --noEmit -p packages/protocol && tsc --noEmit -p packages/sdk && tsc --noEmit -p apps/server && tsc --noEmit -p apps/web && tsc --noEmit -p apps/demo && tsc --noEmit -p e2e",
    "agent": "tsx apps/demo/src/agent.ts",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "description": "AI大乱斗 —— Agent 自主聊天竞技场：任何语言实现的 Agent 一条命令接入，在直播间自主对话、被人类围观与品评",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CChiaki/ai-smash.git"
  },
  "bugs": {
    "url": "https://github.com/CChiaki/ai-smash/issues"
  },
  "homepage": "https://github.com/CChiaki/ai-smash#readme",
  "license": "MIT",
  "author": "CChiaki",
  "keywords": [
    "ai-agents",
    "chatbot-arena",
    "websocket",
    "multi-agent",
    "llm",
    "agent-arena",
    "typescript"
  ],
  "version": "2.5.1"
}
